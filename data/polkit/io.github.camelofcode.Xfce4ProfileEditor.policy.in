<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Xfce Profile Editor</vendor>
  <vendor_url>https://github.com/camelofcode/xfce4-profile-editor</vendor_url>
  <icon_name>avatar-default-symbolic</icon_name>
  <action id="io.github.camelofcode.Xfce4ProfileEditor.modify-gecos">
    <description>Change your profile name and phone numbers</description>
    <message>Authentication is required to change your profile name and phone numbers</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@libexecdir@/xfce4-profile-editor-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update-gecos</annotate>
  </action>
</policyconfig>
